# Environment variables for CivicSpark AI
# Copy this file to .env and fill in your values. Only DATABASE_URL,
# SECRET_KEY, and OPENAI_API_KEY are required for the core experience;
# everything else enables an optional feature.

# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5435/citycamp_db
SECRET_KEY=generate-a-long-random-string-here

# --- LLM provider (open-source models by default) ---
# Chat runs on any OpenAI-compatible endpoint. Defaults: Llama 3.3 70B on
# Groq's free tier (get a key at https://console.groq.com). Other options:
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=llama3.1
LLM_API_KEY=your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Embeddings (Groq doesn't serve embeddings). Default: Jina free tier
# (https://jina.ai/embeddings). Ollama also works:
#   EMBEDDING_BASE_URL=http://localhost:11434/v1  EMBEDDING_MODEL=nomic-embed-text  EMBEDDING_DIMENSIONS=768
# NOTE: changing the embedding model/dimensions requires re-embedding the corpus.
EMBEDDING_API_KEY=your-jina-api-key-here
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSIONS=1024

# Legacy fallback: if LLM_API_KEY/EMBEDDING_API_KEY are unset but this is,
# chat and embeddings run on OpenAI instead.
OPENAI_API_KEY=

# --- Application ---
ENVIRONMENT=development
DEBUG=true
# Comma-separated allowed origins for cross-origin requests, e.g. your Vercel
# domain. Not needed when the frontend proxies /api through Vercel rewrites
# (same-origin).
CORS_ORIGINS=

# --- File storage ---
# "local" (default) stores files under STORAGE_DIR; "s3" requires boto3 + AWS creds.
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# --- Optional features ---
# Representative lookup by address
GEOCODIO_API_KEY=

# SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email notifications
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

# Chatbot web research (Google Custom Search; requires google-api-python-client)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
