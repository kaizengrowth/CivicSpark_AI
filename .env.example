# Environment variables for CivicSpark AI
# Copy this file to .env and fill in your values. Only DATABASE_URL,
# SECRET_KEY, and OPENAI_API_KEY are required for the core experience;
# everything else enables an optional feature.

# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5435/citycamp_db
SECRET_KEY=generate-a-long-random-string-here
OPENAI_API_KEY=your-openai-api-key-here

# --- Application ---
ENVIRONMENT=development
DEBUG=true
# Comma-separated allowed origins for cross-origin requests, e.g. your Vercel
# domain. Not needed when the frontend proxies /api through Vercel rewrites
# (same-origin).
CORS_ORIGINS=

# --- File storage ---
# "local" (default) stores files under STORAGE_DIR; "s3" requires boto3 + AWS creds.
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# --- Optional features ---
# Representative lookup by address
GEOCODIO_API_KEY=

# SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email notifications
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

# Chatbot web research (Google Custom Search; requires google-api-python-client)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
