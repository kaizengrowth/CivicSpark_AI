# Backend environment variables for local development.
# Copy to backend/.env — see the root .env.example for full documentation.

# Required
DATABASE_URL=postgresql://user:password@localhost:5435/citycamp_db
SECRET_KEY=dev-secret-key-not-for-production
OPENAI_API_KEY=your-openai-api-key

# Application
ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=

# File storage
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# Optional features
GEOCODIO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
