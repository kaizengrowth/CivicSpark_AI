# Backend environment variables for local development.
# Copy to backend/.env — see the root .env.example for full documentation.

# Required
DATABASE_URL=postgresql://user:password@localhost:5435/citycamp_db
SECRET_KEY=dev-secret-key-not-for-production

# LLM provider (see root .env.example for alternatives)
LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_API_KEY=your-jina-api-key
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSIONS=1024
# Legacy fallback provider
OPENAI_API_KEY=

# Application
ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=

# File storage
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# Optional features
GEOCODIO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
